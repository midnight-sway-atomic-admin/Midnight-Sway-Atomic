{
    "height": 30,
    "width": 400,
    "spacing": 50,
    "fixed-center": true,

    "modules-center": [
        "sway/workspaces",
        "image#battery",
        "temperature",
        "clock#date",
        "clock#time",
        "tray",
        "custom/power",
        "custom/foot-lock"
    ],

    "sway/workspaces": {
    "cursor": 60,
    "format": "{icon}",
    "format-icons": {
        "focused": "\u25cf",
        "default": "\u25cb"
    }
     },

    "image#battery": {
        "exec": "python3 \"$HOME/.config/waybar/battery-icons.py\"",
        "size": 23,
        "interval": 2,
        "tooltip": false
    },

    "temperature": {
        "interval": 5,
        "critical-threshold": 80,
        "tooltip": false
    },

    "clock#date": {
        "format": "{:%a %d}",
        "tooltip": false
    },

    "clock#time": {
        "format": "{:%H:%M}",
        "tooltip": false
    },

    "tray": {
        "spacing": 50,
        "tooltip": false,
        "cursor": 60
    },

    "custom/foot-lock": {
        "exec": "exec \"$HOME/.local/bin/sway-foot-lock\" watch",
        "on-click": "exec \"$HOME/.local/bin/sway-foot-lock\" toggle",
        "return-type": "json",
        "tooltip": false,
        "exec-on-event": false,
        "restart-interval": 2
    },

    "custom/power": {
        "format": "\u23fb",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "sync && systemctl poweroff",
            "reboot": "reboot",
            "suspend": "systemctl suspend",
            "lock": "swaylock",
            "log off": "loginctl terminate-session $XDG_SESSION_ID"
        }
    }
}
