#!/usr/bin/env bash

logfile="${XDG_RUNTIME_DIR:-/tmp}/rofi-apps.log"
: > "$logfile"

choice="$(printf '%s\n' \
  "Thunar" \
  "Firefox" \
  "Nanowriter" \
  "GIMP" \
  "Wlsunset" \
  "Bluetooth" \
  "Showtime" \
  "Mindmapper" | rofi -dmenu -i -p "Apps")"

printf 'choice=%q\n' "$choice" >> "$logfile"

case "$choice" in
  "Thunar")
    thunar >> "$logfile" 2>&1 &
    ;;

  "Firefox")
    gtk-launch org.mozilla.firefox.desktop >> "$logfile" 2>&1 &
    ;;

  "Nanowriter")
    bash "$HOME/.config/rofi/scripts/nanowriter.sh" >> "$logfile" 2>&1 &
    ;;

  "GIMP")
    flatpak run org.gimp.GIMP --no-splash >> "$logfile" 2>&1 &
    ;;

  "Wlsunset")
    bash "$HOME/.config/rofi/scripts/toggle-sunset.sh" >> "$logfile" 2>&1 &
    ;;

  "Bluetooth")
    GTK_THEME=blueman /usr/bin/python3 "${XDG_DATA_HOME:-$HOME/.local/share}/themes/blueman/blueman-pixmaps-replacement-icons-transparent-option-1/launcher.py" >> "$logfile" 2>&1 &
    ;;

  "Showtime")
    gtk-launch org.gnome.Showtime >> "$logfile" 2>&1 &
    ;;

  "Mindmapper")
    xdg-open "$HOME/.config/mindmapper/mindmapper.html" >> "$logfile" 2>&1 &
    ;;

  "")
    printf 'no choice selected\n' >> "$logfile"
    ;;

  *)
    printf 'unmatched choice=%q\n' "$choice" >> "$logfile"
    ;;
esac
